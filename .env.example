# FraudMesh Environment Configuration

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fraudmesh

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_password

# Redis (optional)
REDIS_URL=redis://localhost:6379

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Bank Institution Keys (for demo/simulation)
BANK_A_PRIVATE_KEY=bank_a_private_key_demo
BANK_B_PRIVATE_KEY=bank_b_private_key_demo
BANK_C_PRIVATE_KEY=bank_c_private_key_demo

# Hyperledger Fabric Configuration
FABRIC_NETWORK=fraudmesh-network
FABRIC_CHANNEL=fraudchannel
FABRIC_CHAINCODE=fraudcc

# ML Model Configuration
MODEL_PATH=./services/ml-training/models
FEATURE_SCHEMA_PATH=./services/ml-training/feature_schema.json

# Application Settings
APP_ENV=development
LOG_LEVEL=INFO
DEBUG=true

# API Settings
API_HOST=0.0.0.0
API_PORT=8000

# Frontend Settings
NEXT_PUBLIC_API_URL=http://localhost:8000
